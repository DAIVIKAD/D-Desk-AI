# =============================================================================
# D Desk AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure with your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file containing secrets.
# =============================================================================

# Application Secret Key
SECRET_KEY=replace_with_a_secure_random_secret_key

# Groq Cloud API Key (Get your free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Groq Model (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Firebase Admin SDK Configuration
# Path to service account JSON (for local development)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Or raw JSON string (ideal for cloud platforms like Render)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Demo Account Credentials (seeded on first startup if accounts don't exist)
DEMO_ADMIN_EMAIL=your_admin_email@example.com
DEMO_ADMIN_PASSWORD=change_me_to_a_secure_password
DEMO_DEFAULT_PASSWORD=change_me_to_a_secure_password

# Optional: Enable Uvicorn auto-reload (1, true, yes, on)
D_DESK_RELOAD=0
